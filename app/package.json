    "compression-streams-polyfill": "^0.1.7",
    "data-async-iterators": "^1.4.6",
    "drizzle-orm": "^0.45.2",
    "expo": "~58.0.22",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.14",
    "expo-dev-client": "~58.0.18",
