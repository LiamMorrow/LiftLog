{
  "name": "liftlog-react",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "prebuild": "expo prebuild",
    "build:android:release": "./android/gradlew assembleRelease",
    "android": "expo run:android  --variant debugOptimized",
    "android:release": "expo run:android --variant release",
    "ios": "expo run:ios",
    "dev": "expo start --dev-client",
    "storybook:start": "EXPO_PUBLIC_STORYBOOK_ENABLED=true expo start --dev-client",
    "storybook:generate": "sb-rn-get-stories --config-path .rnstorybook",
    "lint": "oxlint",
    "lint:fix": "oxlint . --fix",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "postinstall": "patch-package",
    "json-schema": "node ./scripts/generate-json-schemas.js && node ./scripts/build-plan-validator.mjs",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "e2e": "maestro test .maestro --exclude-tags ci-only",
    "e2e:ci": "maestro test .maestro"
  },
  "dependencies": {
    "@babel/plugin-proposal-export-namespace-from": "^7.18.9",
