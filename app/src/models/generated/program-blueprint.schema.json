{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 3
    },
    "name": {
      "type": "string",
      "description": "Name of the workout program; typically matches the plan name."
    },
    "sessions": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/SessionBlueprint"
      }
    },
    "lastEdited": {
      "$ref": "#/definitions/LocalDate"
    }
  },
  "required": ["version", "name", "sessions", "lastEdited"],
  "definitions": {
    "SessionBlueprint": {
      "type": "object",
      "properties": {
        "version": {
          "type": "number",
          "const": 5
        },
        "name": {
          "type": "string"
        },
        "exercises": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ExerciseBlueprint"
          }
        },
        "notes": {
          "type": "string"
        }
      },
      "required": ["version", "name", "exercises", "notes"]
    },
    "ExerciseBlueprint": {
      "type": "object",
      "discriminator": {
        "propertyName": "type"
      },
      "required": ["type"],
      "oneOf": [
        {
          "$ref": "#/definitions/WeightedExerciseBlueprint"
        },
        {
          "$ref": "#/definitions/CardioExerciseBlueprint"
        }
      ]
    },
    "WeightedExerciseBlueprint": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "WeightedExerciseBlueprint"
        },
        "name": {
          "type": "string"
        },
        "plannedSets": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/PlannedSet"
          },
          "description": "What the plan asks for, one entry per set. A list rather than a count plus a shared config: \"fixed / range / per set\" is an authoring convenience, and display collapses equal targets back to \"4 × 10\" for free."
        },
        "restBetweenSets": {
          "$ref": "#/definitions/Rest"
        },
        "supersetWithNext": {
          "type": "boolean",
          "description": "When true, this exercise is performed back-to-back with the following one (a superset), with no rest in between."
        },
        "notes": {
          "type": "string"
        },
        "link": {
          "type": "string",
          "description": "A url to some explanation of how to do this. We should not fill this unless the user has explicitly given us a link to fill"
        },
        "progressiveOverload": {
          "$ref": "#/definitions/ProgressiveOverload"
        },
        "loadBasis": {
          "$ref": "#/definitions/LoadBasis",
          "description": "Where this movement's load comes from, and whether it has one at all.\n\n- `external` - a plain weighted movement; the stored weight is the whole load.\n- `bodyweight` - the base load is the lifter's own bodyweight (pull-ups, dips) and each set's   stored weight is the *added* load on top of it: positive when weighted, negative when assisted.\n- `none` - the exercise does not track a load at all (crunches). Nothing renders a weight,   nothing sums a volume, nothing computes a 1RM, because there is no value to render."
        }
      },
      "required": [
        "type",
        "name",
        "plannedSets",
        "restBetweenSets",
        "supersetWithNext",
        "notes",
        "link",
        "progressiveOverload",
        "loadBasis"
      ]
    },
    "PlannedSet": {
      "type": "object",
      "properties": {
        "reps": {
          "$ref": "#/definitions/RepsTarget"
        }
      },
      "required": ["reps"],
      "description": "What the plan asks for on one set."
    },
    "RepsTarget": {
      "type": "object",
      "properties": {
        "min": {
          "type": "integer"
        },
        "max": {
          "type": "integer"
        }
      },
      "required": ["min", "max"],
      "description": "Always a band; `min === max` is a point target."
    },
    "Rest": {
      "type": "object",
      "properties": {
        "minRest": {
          "$ref": "#/definitions/Duration"
        },
        "maxRest": {
          "$ref": "#/definitions/Duration"
        },
        "failureRest": {
          "$ref": "#/definitions/Duration",
          "description": "Rest taken after a set where the user failed to hit their target reps."
        }
      },
      "required": ["minRest", "maxRest", "failureRest"]
    },
    "Duration": {
      "type": "string",
      "format": "duration"
    },
    "ProgressiveOverload": {
      "type": "object",
      "discriminator": {
        "propertyName": "type"
      },
      "required": ["type"],
      "oneOf": [
        {
          "$ref": "#/definitions/NoProgressiveOverload"
        },
        {
          "$ref": "#/definitions/IncreaseAllEvenlyProgressiveOverload"
        },
        {
          "$ref": "#/definitions/IncreaseLowestSetProgressiveOverload"
        }
      ]
    },
    "NoProgressiveOverload": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "NoProgressiveOverload"
        }
      },
      "required": ["type"],
      "description": "Used when the user does not want progressive overload at all. Potentially with bodyweight exercises."
    },
    "IncreaseAllEvenlyProgressiveOverload": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "IncreaseAllEvenlyProgressiveOverload"
        },
        "amount": {
          "$ref": "#/definitions/BigNumber"
        }
      },
      "required": ["type", "amount"],
      "description": "The standard \"increase every set across the board\" progressive overload. Usually 2.5kg, or 5lb."
    },
    "BigNumber": {
      "type": "string",
      "examples": ["1.23"],
      "format": "decimal"
    },
    "IncreaseLowestSetProgressiveOverload": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "IncreaseLowestSetProgressiveOverload"
        },
        "amount": {
          "$ref": "#/definitions/BigNumber"
        },
        "increaseStrategy": {
          "type": "string",
          "enum": ["first", "middle", "last", "all"]
        }
      },
      "required": ["type", "amount", "increaseStrategy"],
      "description": "A more complex progressive overload which allows the user to increase only a single set, or all sets which have the lowest weight.\n\nA user might want to increase the middle weight for exercises where going up across the board would be too much e.g. lateral raises, or other shoulder exercises"
    },
    "LoadBasis": {
      "type": "string",
      "enum": ["none", "external", "bodyweight"]
    },
    "CardioExerciseBlueprint": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "CardioExerciseBlueprint"
        },
        "name": {
          "type": "string"
        },
        "sets": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/CardioExerciseSetBlueprint"
          }
        },
        "notes": {
          "type": "string"
        },
        "link": {
          "type": "string"
        }
      },
      "required": ["type", "name", "sets", "notes", "link"]
    },
    "CardioExerciseSetBlueprint": {
      "type": "object",
      "properties": {
        "target": {
          "$ref": "#/definitions/CardioTarget"
        },
        "trackDuration": {
          "type": "boolean"
        },
        "trackDistance": {
          "type": "boolean"
        },
        "trackResistance": {
          "type": "boolean"
        },
        "trackIncline": {
          "type": "boolean"
        },
        "trackWeight": {
          "type": "boolean"
        },
        "trackSteps": {
          "type": "boolean"
        },
        "restBetweenSets": {
          "$ref": "#/definitions/Rest",
          "description": "Absent when the set has no rest - steady-state cardio does not need one."
        }
      },
      "required": [
        "target",
        "trackDuration",
        "trackDistance",
        "trackResistance",
        "trackIncline",
        "trackWeight",
        "trackSteps"
      ]
    },
    "CardioTarget": {
      "type": "object",
      "discriminator": {
        "propertyName": "type"
      },
      "required": ["type"],
      "oneOf": [
        {
          "$ref": "#/definitions/TimeCardioTarget"
        },
        {
          "$ref": "#/definitions/DistanceCardioTarget"
        }
      ]
    },
    "TimeCardioTarget": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "time"
        },
        "value": {
          "$ref": "#/definitions/Duration"
        }
      },
      "required": ["type", "value"]
    },
    "DistanceCardioTarget": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "distance"
        },
        "value": {
          "$ref": "#/definitions/Distance"
        }
      },
      "required": ["type", "value"]
    },
    "Distance": {
      "type": "object",
      "properties": {
        "value": {
          "$ref": "#/definitions/BigNumber"
        },
        "unit": {
          "$ref": "#/definitions/DistanceUnit"
        }
      },
      "required": ["value", "unit"]
    },
    "DistanceUnit": {
      "type": "string",
      "enum": ["metre", "yard", "mile", "kilometre"]
    },
    "LocalDate": {
      "type": "string",
      "format": "date"
    }
  }
}
